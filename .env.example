APP_NAME="codebar Solutions AG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://web-codebar.test

# Trusted proxies: `*` (default) trusts X-Forwarded-* from the TCP peer (typical Herd/Valet/nginx). For production, set your load balancer IPs/CIDRs as a comma-separated list.
# TRUSTED_PROXIES=*

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Nightwatch is required for production-style deployments: set NIGHTWATCH_TOKEN, enable the agent (`php artisan nightwatch:agent`, supervised), and keep LOG_STACK including `nightwatch`.
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=

# No content database is needed (content is markdown). Leave SQLite as a stub for cache/jobs if you opt into the database driver for those.
DB_CONNECTION=sqlite

FPH_ENABLED=true
CSP_ENABLED=true

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Markdown content cache (see config/content.php).
CONTENT_CACHE_TTL=3600

# Postmark for transactional mail.
MAIL_MAILER=log
POSTMARK_TOKEN=

MAIL_FROM_ADDRESS="hello@codebar.ch"
MAIL_FROM_NAME="${APP_NAME}"

# Lasso (deployment asset bundling) uses the `s3` disk (`AWS_*`). Set LASSO_ENV to match production (e.g. production).
AWS_ACCESS_KEY_ID=
AWS_BUCKET=
AWS_DEFAULT_REGION=fra1
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com
AWS_CDN_ENDPOINT=https://srv-dev-space-fra-001.fra1.cdn.digitaloceanspaces.com
AWS_SECRET_ACCESS_KEY=
# LASSO_ENV=production
# LARAVEL_CLOUD_DEPLOY_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"

# Analytics (see config/default.php — loaded only in configured environments, e.g. staging/production)
# LARAVEL_DEFAULT_FATHOM_SITE_ID=
# LARAVEL_DEFAULT_FATHOM_URL=https://cdn-eu.usefathom.com/script.js

# Cloudinary delivers all images. Set the cloud name; URLs are constructed from there.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Spatie Health + Oh Dear.
OH_DEAR_HEALTH_CHECK_ENABLED=false
OH_DEAR_HEALTH_CHECK_SECRET=
OH_DEAR_HEALTH_CHECK_PATH=/oh-dear-health-check-results
