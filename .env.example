APP_NAME="codebar Solutions AG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://web.codebar.test

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Nightwatch. Disabled locally; set the token in staging/production.
# The agent ships with Laravel Cloud — elsewhere it has to be supervised.
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=web-codebar
DB_USERNAME=postgres
DB_PASSWORD=postgres

FPH_ENABLED=true
CSP_ENABLED=true
CSP_NONCE_ENABLED=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=web.codebar.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Not "sync": the network profile link is sent from a queued job, and running it inside
# the request makes the deliberately constant response observable by its timing.
# Needs `php artisan queue:work` (see README).
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME="Template Laravel"
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

MAIL_FROM_ADDRESS="test@template.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_BUCKET=
AWS_DEFAULT_REGION=fra1
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com
AWS_CDN_ENDPOINT=https://srv-dev-space-fra-001.fra1.cdn.digitaloceanspaces.com
AWS_PATH=
AWS_SECRET_ACCESS_KEY=

VITE_APP_NAME="${APP_NAME}"

CLOUDINARY_CLOUD_NAME=my-cloud-name
CLOUDINARY_API_KEY=my-api-key
CLOUDINARY_API_SECRET=my-api-secret

LARAVEL_DEFAULT_FATHOM_SITE_ID=WECFOADW
LITELLM_URL=https://llm.codebar.net
LITELLM_MASTER_KEY=
GITHUB_TOKEN=

# Where a failing health check reports to. Unset means no notification is sent.
HEALTH_NOTIFICATION_EMAIL=
